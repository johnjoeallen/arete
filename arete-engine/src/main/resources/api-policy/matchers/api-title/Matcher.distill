distill(api, rule) {
    return api.info.title.isBlank()
        ? []
        : (rule.parameters["suffix"] != null && !api.info.title.trim().endsWith(rule.parameters["suffix"])
            ? [occurrence("/info/title", api.info.title,
                "API title does not end with '{{rule.parameters["suffix"]}}'")]
            : [])
        + tokenise(",", "{{rule.parameters["forbidden"]}}")
            .map { token -> token.trim() }
            .filter { token -> token != ""
                && token.lower() == last(words(api.info.title)).lower() }
            .map { token -> occurrence("/info/title", api.info.title,
                "API title ends with the discouraged marker '{{token}}'") }
        + (rule.parameters["case"] == "title-case"
            ? words(api.info.title)
                .filter { word ->
                    !(word.lower() ==~ /(a|an|and|as|at|but|by|for|in|of|on|or|the|to|via|with)/)
                    && word.length > 3
                    && !(word ==~ /[A-Z0-9].*/) }
                .map { word -> occurrence("/info/title", api.info.title,
                    "API title word '{{word}}' is not in Title Case") }
            : []);
}
