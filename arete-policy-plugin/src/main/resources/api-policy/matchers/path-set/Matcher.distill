distill(api, rule) {
    return api.paths
        .filter { path -> api.paths.find { other ->
            join("/", tokenise("/", other.path).map { s -> (s.startsWith("{") && s.endsWith("}")) ? "{}" : s })
            == join("/", tokenise("/", path.path).map { s -> (s.startsWith("{") && s.endsWith("}")) ? "{}" : s }) }
            != path }
        .map { path -> occurrence(path.pointer, path.path,
            "Path is structurally identical to "
            + api.paths.find { other ->
                join("/", tokenise("/", other.path).map { s -> (s.startsWith("{") && s.endsWith("}")) ? "{}" : s })
                == join("/", tokenise("/", path.path).map { s -> (s.startsWith("{") && s.endsWith("}")) ? "{}" : s }) }.path) };
}
