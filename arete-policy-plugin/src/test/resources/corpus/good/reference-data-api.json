{
  "openapi": "3.0.3",
  "info": {
    "title": "Reference Data API",
    "description": "Read-only lists of countries and currencies.",
    "version": "1.0.0",
    "contact": { "name": "Data Platform Team", "email": "data-platform@acme-retail.com" },
    "license": { "name": "Apache-2.0", "url": "https://www.apache.org/licenses/LICENSE-2.0" }
  },
  "x-api-id": "c4a1b9f2-5d0e-4b7a-8e63-1a2f9d7c3e55",
  "x-audience": "company-internal",
  "servers": [ { "url": "https://api.acme-retail.com" } ],
  "tags": [ { "name": "reference-data", "description": "Lists that change rarely." } ],
  "security": [ { "bearerAuth": [ "read", "write" ] } ],
  "paths": {
    "/countries": {
      "get": {
        "tags": [ "reference-data" ],
        "operationId": "listCountries",
        "summary": "List all countries",
        "description": "Returns every supported country.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Maximum number of countries to return.", "example": 50,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } },
          { "name": "cursor", "in": "query", "description": "Opaque cursor returned by the previous page.", "example": "eyJvIjo1MH0",
            "schema": { "type": "string", "maxLength": 200 } },
          { "name": "filter", "in": "query", "description": "Filter expression, for example region eq europe.", "example": "region eq europe",
            "schema": { "type": "string", "maxLength": 200 } },
          { "name": "sort", "in": "query", "description": "Sort expression, for example name asc.", "example": "name asc",
            "schema": { "type": "string", "maxLength": 100 } },
          { "name": "fields", "in": "query", "description": "Comma separated list of fields to return.", "example": "code,name",
            "schema": { "type": "string", "maxLength": 200 } }
        ],
        "responses": {
          "200": {
            "description": "A page of countries.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CountryPage" } } }
          },
          "401": {
            "description": "Authentication is required.",
            "headers": { "WWW-Authenticate": { "description": "The authentication challenge.", "schema": { "type": "string", "maxLength": 200 } } },
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/currencies": {
      "get": {
        "tags": [ "reference-data" ],
        "operationId": "listCurrencies",
        "summary": "List all currencies",
        "description": "Returns every supported currency.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Maximum number of currencies to return.", "example": 50,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } },
          { "name": "cursor", "in": "query", "description": "Opaque cursor returned by the previous page.", "example": "eyJvIjo1MH0",
            "schema": { "type": "string", "maxLength": 200 } },
          { "name": "filter", "in": "query", "description": "Filter expression, for example code eq EUR.", "example": "code eq EUR",
            "schema": { "type": "string", "maxLength": 200 } },
          { "name": "sort", "in": "query", "description": "Sort expression, for example code asc.", "example": "code asc",
            "schema": { "type": "string", "maxLength": 100 } },
          { "name": "fields", "in": "query", "description": "Comma separated list of fields to return.", "example": "code,name",
            "schema": { "type": "string", "maxLength": 200 } }
        ],
        "responses": {
          "200": {
            "description": "A page of currencies.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CurrencyPage" } } }
          },
          "401": {
            "description": "Authentication is required.",
            "headers": { "WWW-Authenticate": { "description": "The authentication challenge.", "schema": { "type": "string", "maxLength": 200 } } },
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "Country": {
        "type": "object",
        "description": "A country.",
        "required": [ "code", "name" ],
        "properties": {
          "code": { "type": "string", "maxLength": 2, "description": "ISO 3166 alpha-2 code.", "example": "DE" },
          "name": { "type": "string", "maxLength": 100, "description": "English short name.", "example": "Germany" }
        },
        "example": { "code": "DE", "name": "Germany" }
      },
      "Currency": {
        "type": "object",
        "description": "A currency.",
        "required": [ "code", "name" ],
        "properties": {
          "code": { "type": "string", "maxLength": 3, "description": "ISO 4217 code.", "example": "EUR" },
          "name": { "type": "string", "maxLength": 100, "description": "English name.", "example": "Euro" }
        },
        "example": { "code": "EUR", "name": "Euro" }
      },
      "CountryPage": {
        "type": "object",
        "required": [ "items" ],
        "properties": {
          "nextCursor": { "type": "string", "maxLength": 200, "description": "Cursor for the next page, absent on the last page.", "example": "eyJvIjo1MH0" },
          "items": { "type": "array", "description": "The countries on this page.", "example": [], "maxItems": 100,
                     "items": { "$ref": "#/components/schemas/Country" } }
        },
        "example": { "items": [] }
      },
      "CurrencyPage": {
        "type": "object",
        "required": [ "items" ],
        "properties": {
          "nextCursor": { "type": "string", "maxLength": 200, "description": "Cursor for the next page, absent on the last page.", "example": "eyJvIjo1MH0" },
          "items": { "type": "array", "description": "The currencies on this page.", "example": [], "maxItems": 100,
                     "items": { "$ref": "#/components/schemas/Currency" } }
        },
        "example": { "items": [] }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "format": "uri", "maxLength": 2000, "description": "Problem type identifier.", "example": "https://api.acme-retail.com/problems/unauthorised" },
          "title": { "type": "string", "maxLength": 200, "description": "Short summary of the problem.", "example": "Authentication required" },
          "status": { "type": "integer", "format": "int32", "minimum": 100, "maximum": 599, "description": "HTTP status code.", "example": 401 },
          "detail": { "type": "string", "maxLength": 1000, "description": "Explanation specific to this occurrence.", "example": "No valid bearer token was supplied." }
        },
        "example": { "type": "https://api.acme-retail.com/problems/unauthorised", "title": "Authentication required", "status": 401, "detail": "No valid bearer token was supplied." }
      }
    }
  }
}
