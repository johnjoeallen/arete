<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>speculate</groupId>
    <artifactId>zally-validation-plugin</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>zally-validation-plugin</name>
    <description>SpecValidationPlugin adapter wrapping Zalando's Zally API linter (zally-core + the zally ruleset), Speculate's bundled default validator</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <zally.version>2.1.1</zally.version>
    </properties>

    <dependencies>
        <!-- Compile-only: the host's classloader already provides this jar to every
             plugin's isolated URLClassLoader as its parent, so it must not be
             repackaged into the plugin jar. -->
        <dependency>
            <groupId>speculate</groupId>
            <artifactId>speculate-validation-spi</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Everything below this point DOES need to be shaded into the plugin jar
             (see the shade-plugin config): the isolated URLClassLoader Speculate
             loads this plugin with sees only this one jar file, so it must be
             fully self-contained. Zally pulls in a sizeable dependency tree
             (an older swagger-parser stack, Guava, Apache HttpClient, Kotlin's
             stdlib/reflect, typesafe config, ...) — isolation is exactly why that's
             safe here: none of it is visible to Speculate itself or to any other
             plugin. -->
        <dependency>
            <groupId>org.zalando</groupId>
            <artifactId>zally-core</artifactId>
            <version>${zally.version}</version>
        </dependency>
        <dependency>
            <groupId>org.zalando</groupId>
            <artifactId>zally-ruleset-zalando</artifactId>
            <version>${zally.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Zally's dependency tree includes an annotation processor
                     (com.google.auto.service) that javac's default -proc:auto
                     otherwise picks up and tries to run against our own
                     sources — a Kotlin-compiled processor class that then
                     fails to load kotlin-stdlib at APT time. We don't use
                     annotation processing ourselves, so just turn it off. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <proc>none</proc>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <!-- Bundles zally-core/zally-ruleset-zalando and their transitive
                     dependencies into this jar (everything except the SPI, which
                     stays provided — see the dependency comment above). The
                     ServicesResourceTransformer merges META-INF/services files
                     rather than letting one shaded dependency's copy clobber
                     another's; Zally's own rule discovery (RulesManager.fromClassLoader)
                     depends on META-INF/services/org.zalando.zally.rule.api.Rule
                     surviving the shade intact. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                <!-- zally-core and zally-ruleset-zalando each carry their own
                                     reference.conf at the same path; without this, shading
                                     silently keeps only one and drops the other's rule config
                                     (e.g. ApiAudienceRule's default audience list), which then
                                     fails at runtime with ConfigException.Missing instead of at
                                     build time. typesafe-config's own docs recommend exactly
                                     this transformer for this situation — HOCON concatenates
                                     top-level stanzas from appended files fine. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>reference.conf</resource>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Bound to integration-test/verify so the smoke test can load the
                     already-packaged jar the same way the host will: as a real jar
                     file through an isolated URLClassLoader + ServiceLoader, not the
                     exploded target/classes directory. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
