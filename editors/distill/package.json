{
  "name": "distill-syntax",
  "displayName": "Distill (Areté matcher DSL)",
  "description": "Syntax highlighting for Distill — the Groovy influenced fluent rule language used in Areté Matcher.distill files.",
  "version": "0.2.0",
  "publisher": "arete",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnjoeallen/arete.git",
    "directory": "editors/distill"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "distill",
        "aliases": ["Distill", "distill"],
        "extensions": [".distill"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "distill",
        "scopeName": "source.distill",
        "path": "./distill.tmLanguage.json"
      }
    ]
  }
}
